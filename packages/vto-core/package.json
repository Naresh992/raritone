{
  "name": "@raritone/vto-core",
  "version": "0.1.0",
  "description": "Provider-independent VTO contracts and pure utilities for the Raritone platform",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "raritone",
    "vto",
    "virtual-try-on",
    "contracts"
  ]
}
