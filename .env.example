# ============================================================
# Raritone — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Core ---
APP_ENV=development                # development | production
DATABASE_URL=sqlite:///./raritone.db   # postgresql+psycopg://user:pass@host:5432/raritone in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
SIGNING_SECRET=change-me-too-used-for-signed-image-urls

# --- Admin bootstrap (used by seed script) ---
ADMIN_EMAIL=admin@raritone.com
ADMIN_PASSWORD=change-me-admin
DEMO_EMAIL=demo@raritone.com
DEMO_PASSWORD=demo1234

# --- Try-On engine ---
# provider: mock (local Pillow composite, no external calls) | remote (your AI model)
TRYON_PROVIDER=mock
TRYON_API_URL=                     # e.g. https://tryon.internal.raritone.com/v1/generate
TRYON_API_KEY=                     # server-side only, never exposed to frontend
TRYON_TIMEOUT=30                   # seconds

# --- OTP / SMS ---
# provider: console (logs OTP to server console, DEV ONLY) | msg91
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RARITN
OTP_DEV_MODE=true                  # returns OTP in API response for development/testing

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Payments (Razorpay) ---
# Leave blank to run checkout in DEMO mode (no real charges).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Storage ---
STORAGE_DIR=./data/private         # private uploads: NEVER served by static file server
UPLOAD_RETENTION_DAYS=30           # try-on inputs/outputs auto-expire after this
MAX_UPLOAD_MB=10

# --- Live VTO (realtime, Decart Lucy VTON) ---
# Official flow: backend mints short-lived Decart client tokens
# (POST {DECART_API_BASE}/v1/client/tokens, header x-api-key);
# browser connects with @decartai/sdk (models.realtime("lucy-vton-latest")).
LIVE_VTO_PROVIDER=mock             # mock (dev/demo only) | decart (production) | raritone (future stub)
LIVE_VTO_MOCK_ENABLED=true         # dev only; forced OFF when APP_ENV=production
DECART_API_KEY=                    # permanent key dct_* from https://platform.decart.ai — SERVER ONLY, never NEXT_PUBLIC_*
DECART_API_BASE=https://api.decart.ai
DECART_MODEL_ID=lucy-vton-latest   # verified: models.realtime("lucy-vton-latest"); alt: lucy-vton-3.5
DECART_ALLOWED_ORIGINS=            # optional, comma-separated canonical origins, e.g. https://shop.raritone.com
# LEGACY (self-hosted LiveKit experiments only — NOT used by the decart provider):
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_VTO_MAX_DURATION_SEC=300      # hard cap per session (also enforced as Decart token maxSessionDuration)
LIVE_VTO_TOKEN_TTL_SEC=300         # Decart client-token TTL in seconds (1-3600); fresh token per session
LIVE_VTO_QUOTA_PER_HOUR=10
LIVE_VTO_MAX_CONCURRENT_PER_USER=2
LIVE_VTO_PRICE_PER_MIN_USD=0.05    # estimated cost; confirm against https://platform.decart.ai pricing
LIVE_VTO_INACTIVITY_TIMEOUT_SEC=120

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60           # global default
RATE_LIMIT_AUTH_PER_MINUTE=10      # OTP/login endpoints
RATE_LIMIT_TRYON_PER_HOUR=30       # try-on generations per user/IP

# --- Frontend (prefix with NEXT_PUBLIC_ to reach the browser) ---
# In frontend/.env.local:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_RAZORPAY_KEY_ID=      # Razorpay PUBLIC key id (safe for frontend)
