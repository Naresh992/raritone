# ============================================================
# Raritone — environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Core ---
APP_ENV=development
AUTO_CREATE_SCHEMA=true
POSTGRES_DB=raritone
POSTGRES_USER=raritone
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=sqlite:///./raritone.db
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
SIGNING_SECRET=change-me-too-used-for-signed-image-urls

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@raritone.com
ADMIN_PASSWORD=change-me-admin
DEMO_EMAIL=demo@raritone.com
DEMO_PASSWORD=demo1234

# --- Try-On engine ---
# mock is development-only; production requires a configured remote inference service.
TRYON_PROVIDER=mock
TRYON_API_URL=
TRYON_API_KEY=
TRYON_TIMEOUT=30

# --- OTP / SMS ---
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RARITN
OTP_DEV_MODE=true

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Storage ---
STORAGE_DIR=./data/private
UPLOAD_RETENTION_DAYS=30
MAX_UPLOAD_MB=10

# --- Live VTO (realtime) ---
LIVE_VTO_PROVIDER=mock
LIVE_VTO_MOCK_ENABLED=true
DECART_API_KEY=
DECART_API_BASE=https://api.decart.ai
DECART_MODEL_ID=lucy-vton-latest
DECART_ALLOWED_ORIGINS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_VTO_MAX_DURATION_SEC=300
LIVE_VTO_TOKEN_TTL_SEC=300
LIVE_VTO_QUOTA_PER_HOUR=10
LIVE_VTO_MAX_CONCURRENT_PER_USER=2
LIVE_VTO_PRICE_PER_MIN_USD=0.05
LIVE_VTO_INACTIVITY_TIMEOUT_SEC=120

# --- Rate limits ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TRYON_PER_HOUR=30

# --- Frontend ---
# In frontend/.env.local:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
