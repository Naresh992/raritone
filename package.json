{
  "name": "raritone-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Raritone VTO platform — provider-independent virtual try-on SDKs and packages",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:sdk && npm run build:react",
    "build:core": "npm run build --workspace @raritone/vto-core",
    "build:sdk": "npm run build --workspace @raritone/live-vto-sdk",
    "build:react": "npm run build --workspace @raritone/react-vto",
    "test": "npm run test --workspace @raritone/live-vto-sdk",
    "clean": "rimraf packages/vto-core/dist packages/live-vto-sdk/dist packages/react-vto/dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
